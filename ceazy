  function toggleThermal() {
    isThermal = !isThermal;
    if (isThermal) {
      globe.style.filter = 'hue-rotate(180deg) saturate(2.4) contrast(1.35) drop-shadow(0 10px 40px rgba(180,83,9,0.5))';
