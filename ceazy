      globe.style.clipPath = 'polygon(0% 0%, 58% 0%, 52% 100%, 0% 100%)';
      btnTerminator.classList.add('text-primary', 'bg-surface-container');
      btnTerminator.classList.remove('text-on-surface-variant');
    } else {
      globe.style.clipPath = 'none';
      btnTerminator.classList.remove('text-primary', 'bg-surface-container');
      btnTerminator.classList.add('text-on-surface-variant');
    }
  }

  function applyFilters() {
    if (!isThermal) {
      globe.style.filter = 'drop-shadow(0 10px 35px rgba(0,40,105,0.4))';
    }
  }

  function resetView() {
    isSpinning = false;
    isThermal = false;
    isTerminator = false;
    globe.className = 'relative z-10 w-full h-full object-contain filter drop-shadow-[0_10px_35px_rgba(0,40,105,0.4)] transition-all duration-700';
    globe.style.filter = '';
    globe.style.clipPath = '';
    
    btnSpin.className = 'px-space-md py-1 rounded bg-surface-container-low hover:bg-surface-container border border-surface-divider text-primary font-label-md text-label-md uppercase tracking-wider flex items-center gap-1 transition-all';
    btnThermal.className = 'px-space-md py-1 rounded bg-surface-container-low hover:bg-surface-container border border-surface-divider text-on-surface-variant font-label-md text-label-md uppercase tracking-wider flex items-center gap-1 transition-all';
    btnTerminator.className = 'px-space-md py-1 rounded bg-surface-container-low hover:bg-surface-container border border-surface-divider text-on-surface-variant font-label-md text-label-md uppercase tracking-wider flex items-center gap-1 transition-all';
  }
