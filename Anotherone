    { badge: "74", title: "Mariner 10 Flybys", text: "Mapped 45% of surface; discovered surprising magnetic dipole." },
    { badge: "11", title: "MESSENGER Orbital Tour", text: "4,104 orbits over 4 years; completed global basaltic mapping." },
    { badge: "26", title: "BepiColombo (ESA / JAXA)", text: "Dual orbiters arriving to investigate exosphere and deep core interior." }
  ]
};

/* small folio visuals (bars, thermometer, ring) */
function vizHTML(items) {
  var e = escHtml;
  return "<div class=\"fv\">" + items.map(function (v) {
    if (v.kind === "bar") {
      return "<div class=\"fv-row\"><span>" + e(v.label) + "</span><b>" + e(v.value) + "</b></div><div class=\"fv-bar\">" +
        v.parts.map(function (p) { return "<i style=\"flex:" + p[0] + ";background:" + p[1] + "\"></i>"; }).join("") + "</div>";
    }
    if (v.kind === "thermal") {
      return "<div class=\"fv-row\"><b style=\"color:#0369a1\">" + e(v.left) + "</b><b style=\"color:#be123c\">" + e(v.right) + "</b></div><div class=\"fv-thermal\"><i style=\"left:" + v.marker + "%\"></i></div>";
    }
    if (v.kind === "donut") {
      return "<div class=\"fv-donut\"><svg viewBox=\"0 0 40 40\"><circle cx=\"20\" cy=\"20\" r=\"16\" fill=\"none\" stroke=\"#e6dcc0\" stroke-width=\"4\"/><circle cx=\"20\" cy=\"20\" r=\"16\" fill=\"none\" stroke=\"#c9553c\" stroke-width=\"4\" stroke-linecap=\"round\" pathLength=\"100\" stroke-dasharray=\"100\" stroke-dashoffset=\"" + (100 - v.pct) + "\" transform=\"rotate(-90 20 20)\"/><text x=\"20\" y=\"24\" text-anchor=\"middle\" font-size=\"9\" font-weight=\"700\" fill=\"#182a58\">" + v.pct + "%</text></svg><div><b>" + e(v.title) + "</b><span>" + e(v.text) + "</span></div></div>";
    }
    if (v.kind === "progress") {
      return "<div class=\"fv-row\"><span>" + e(v.label) + "</span><b>" + e(v.value) + "</b></div><div class=\"fv-bar\"><i style=\"flex:" + v.pct + ";background:" + v.color + "\"></i><i style=\"flex:" + (100 - v.pct) + ";background:transparent\"></i></div>";
    }
    return "<div class=\"fv-row\"><span>" + e(v.label) + "</span><b>" + e(v.value) + "</b></div>";
  }).join("") + "</div>";
}

/* margin notes (kept in this browser; previews that block storage still work for the session) */
var NOTES_MEM = {};
function notesGet(id) {
  try { var s = localStorage.getItem("notes:" + id); if (s) { return JSON.parse(s); } } catch (err) {}
  return NOTES_MEM[id] || [];
}
function notesAdd(id, text) {
  var a = notesGet(id); a.push(text); NOTES_MEM[id] = a;
  try { localStorage.setItem("notes:" + id, JSON.stringify(a)); } catch (err) {}
  return a;
}
function notesHTML(id) {
  var a = notesGet(id);
  return a.length ? a.map(function (t) { return "<li>" + escHtml(t) + "</li>"; }).join("") : "<li class=\"mt\">No margin notes yet.</li>";
}

var toastTimer = null;
function showToast(msg) {
  var t = document.getElementById("toast");
  t.textContent = msg; t.classList.add("on");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function () { t.classList.remove("on"); }, 2400);
}

/* page-turn: a cream leaf swings across the screen while the page underneath changes */
function pageTurn(fn) {
  var w = document.getElementById("leafwrap");
  var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!w || reduce) { fn(); return; }
  w.classList.remove("go"); void w.offsetWidth; w.classList.add("go");
  fn();
}
document.getElementById("leafwrap").addEventListener("animationend", function (e) {
  if (e.animationName === "leaf") { this.classList.remove("go"); }
});


/* ---------- the book: three two-page spreads ---------- */
var $ = function (id) { return document.getElementById(id); };
var TAB_NAMES = ["I · Visual observation", "II · Research folios", "III · Field log & datasets"];
var spread = 1, firstRoute = true, bkIdx = 0, bkFx = { rot: 0, term: false, therm: false };

/* where the "back" and "next world" buttons lead (the solar system lives in index.html) */
var LINK_SOLAR = "index.html#orrery", LINK_NEXT = "index.html#planet/venus", NEXT_NAME = "Venus";

function go(n) { if (location.hash === "#" + n) { route(); } else { location.hash = "#" + n; } }

function bkPage(headL, headR, body, num) {
  return "<div class=\"bk-head\"><span>" + escHtml(headL) + "</span><span>" + escHtml(headR) + "</span></div><div class=\"bk-body\">" + body + "</div><div class=\"bk-folio\">— " + num + " —</div>";
}
function folioCard(f) {
  var e = escHtml;
  return "<article class=\"bk-fc\"><div class=\"bk-fh\"><b>" + e(f.code) + "</b><span>" + e(f.tag) + "</span></div><h3>" + e(f.title) + "</h3><p>" + e(f.text) + "</p>" + vizHTML(f.viz) + "<div class=\"bk-ff\">" + e(f.foot) + "</div></article>";
}

function render(n) {
  spread = n;
  var d = M, e = escHtml, L, R;
  document.title = "Mercury — A storybook by NASA";

  if (n === 1) {
    L = bkPage(d.journal, "Part I · Visual observation",
      "<div class=\"bk-viewer\"><div class=\"bk-vhead\"><span><i class=\"rd\"></i>" + e(d.viewport.instrument) + "</span><span>" + e(d.viewport.bands) + "</span></div>" +
      "<div class=\"bk-stage\"><img id=\"bk-img\" alt=\"\"><div class=\"bk-cap\" id=\"bk-cap\">Loading photos…</div></div>" +
      "<div class=\"bk-ctrls\"><button type=\"button\" data-fx=\"rot\">⟳ Rotate</button><button type=\"button\" data-fx=\"term\">◐ Terminator</button><button type=\"button\" data-fx=\"therm\">♨ Thermal</button><a id=\"bk-full\" href=\"#\" target=\"_blank\" rel=\"noopener\">Full image ↗</a></div>" +
      "<div class=\"bk-thumbs\" id=\"bk-thumbs\"></div></div>", 1);
    R = bkPage(d.entry, d.kind,
      "<div class=\"bk-kicker\">Object 02 · Mercury</div>" +
      "<h2 class=\"bk-title\">" + e(d.title) + "</h2>" +
      "<p class=\"bk-intro\">" + e(d.intro) + "</p>" +
      "<div class=\"bk-quote\"><p>" + e(d.quote) + "</p><span>" + e(d.quoteBy) + "</span></div>" +
      "<div class=\"bk-ledger\">" + d.ledger.map(function (c) { return "<div class=\"bk-chip\"><span>" + e(c[0]) + "</span><b>" + e(c[1]) + "</b><i>" + e(c[2]) + "</i></div>"; }).join("") + "</div>" +
      "<div class=\"bk-core\"><div><span>" + e(d.core[0]) + "</span><b>" + e(d.core[1]) + "</b></div><div class=\"r\"><b>" + e(d.core[2]) + "</b><span>" + e(d.core[3]) + "</span></div></div>", 2);
  } else if (n === 2) {
    L = bkPage(d.journal, "Part II · Research folios", folioCard(d.folios[0]) + folioCard(d.folios[1]), 3);
    R = bkPage("Research folios & archives", d.kind, folioCard(d.folios[2]) + folioCard(d.folios[3]), 4);
  } else {
    L = bkPage(d.journal, "Part III · Field log",
      "<div class=\"bk-sub\">Observation log</div><div class=\"bk-place\">" + e(d.log.place) + "</div><blockquote class=\"bk-bq\">" + e(d.log.quote) + "</blockquote>" +
      "<div class=\"bk-sub\" style=\"margin-top:6px\">Margin notes</div>" +
      "<div class=\"bk-note\"><input id=\"bk-note\" type=\"text\" maxlength=\"200\" placeholder=\"Write a note in the margin…\"><button id=\"bk-save\" type=\"button\">Add note</button></div>" +
      "<ul class=\"bk-notes\" id=\"bk-notes\"></ul>", 5);
    R = bkPage("Calibrated science datasets", d.kind,
      "<div class=\"bk-sub\">Datasets</div><div class=\"bk-ds\">" + d.datasets.map(function (s, k) { return "<button type=\"button\" data-ds=\"" + k + "\"><span>" + e(s.kind) + "</span><b>" + e(s.title) + "</b><i>" + e(s.size) + "</i></button>"; }).join("") + "</div>" +
      "<div class=\"bk-sub\" style=\"margin-top:6px\">Deep space probes</div><div class=\"bk-tl\">" + d.timeline.map(function (t) { return "<div><em>" + e(t.badge) + "</em><div><b>" + e(t.title) + "</b><span>" + e(t.text) + "</span></div></div>"; }).join("") + "</div>" +
      "<div class=\"bk-credit\">Photos: NASA Image and Video Library</div>", 6);
  }
  $("bk-l").innerHTML = L;
  $("bk-r").innerHTML = R;

  $("bk-tabs").innerHTML = TAB_NAMES.map(function (t, k) { return "<button type=\"button\" data-sp=\"" + (k + 1) + "\"" + (k + 1 === n ? " class=\"on\"" : "") + ">" + e(t) + "</button>"; }).join("");
  Array.prototype.forEach.call($("bk-tabs").children, function (btn) { btn.onclick = function () { go(Number(btn.getAttribute("data-sp"))); }; });
  $("bk-prev").textContent = n > 1 ? "← Previous page" : "← Solar system";
  $("bk-next").textContent = n < 3 ? "Next page →" : "Next world: " + NEXT_NAME + " →";
  $("bk-prev").onclick = bookPrev;
  $("bk-next").onclick = bookNext;

  if (n === 1) { viewerInit(); }
  if (n === 3) { notesInit(); }
}

function bookNext() { if (spread < 3) { go(spread + 1); } else { location.href = LINK_NEXT; } }
function bookPrev() { if (spread > 1) { go(spread - 1); } else { location.href = LINK_SOLAR; } }

/* photo viewer (page 1) */
function applyFx() {
  var img = $("bk-img"); if (!img) { return; }
  var f = [];
  if (bkFx.therm) { f.push("hue-rotate(180deg) saturate(2.5) contrast(1.2)"); }
  if (bkFx.term) { f.push("contrast(1.6) brightness(.85)"); }
  img.style.filter = f.length ? f.join(" ") : "none";
  img.style.transform = "rotate(" + bkFx.rot + "deg)" + (bkFx.rot % 180 ? " scale(.7)" : "");
  Array.prototype.forEach.call(document.querySelectorAll(".bk-ctrls [data-fx]"), function (btn) {
    var k = btn.getAttribute("data-fx");
    btn.classList.toggle("on", k === "rot" ? bkFx.rot !== 0 : !!bkFx[k]);
  });
}
function showPhoto(k) {
  var im = PHOTOS[k];
  bkIdx = k;
  var img = $("bk-img");
  img.src = im.big; img.alt = im.alt;
  $("bk-cap").textContent = im.caption;
  $("bk-full").href = im.big;
  Array.prototype.forEach.call($("bk-thumbs").children, function (t, j) { t.classList.toggle("on", j === k); });
  applyFx();
}
function viewerInit() {
  bkFx = { rot: 0, term: false, therm: false };
  Array.prototype.forEach.call(document.querySelectorAll(".bk-ctrls [data-fx]"), function (btn) {
    btn.onclick = function () {
      var k = btn.getAttribute("data-fx");
      if (k === "rot") { bkFx.rot = (bkFx.rot + 90) % 360; } else { bkFx[k] = !bkFx[k]; }
      applyFx();
    };
  });
  $("bk-thumbs").innerHTML = PHOTOS.map(function (im, k) { return "<button type=\"button\" aria-label=\"Photo " + (k + 1) + "\"><img src=\"" + escHtml(im.src) + "\" alt=\"\"></button>"; }).join("");
  Array.prototype.forEach.call($("bk-thumbs").children, function (t, k) { t.onclick = function () { showPhoto(k); }; });
  showPhoto(bkIdx);
}

/* margin notes + dataset tiles (page 3) */
function notesInit() {
  var inp = $("bk-note"), list = $("bk-notes");
  list.innerHTML = notesHTML("mercury");
  $("bk-save").onclick = function () {
    var v = inp.value.trim();
    if (!v) { inp.focus(); return; }
    notesAdd("mercury", v); inp.value = ""; list.innerHTML = notesHTML("mercury");
    showToast("Note added to the margin.");
  };
  inp.onkeydown = function (ev) { if (ev.key === "Enter") { $("bk-save").click(); } };
  Array.prototype.forEach.call(document.querySelectorAll(".bk-ds button"), function (btn) {
    btn.onclick = function () {
      var s = M.datasets[Number(btn.getAttribute("data-ds"))];
      if (s && s.href) { window.open(s.href, "_blank", "noopener"); } else { showToast("This dataset link is not set up yet."); }
    };
  });
}

/* routing: #1, #2, #3 are the three spreads (so the browser Back button turns pages) */
function route() {
  var n = parseInt((location.hash || "#1").slice(1), 10) || 1;
  n = Math.max(1, Math.min(3, n));
  var run = function () { render(n); };
  if (firstRoute) { firstRoute = false; run(); pageTurn(function () {}); } else { pageTurn(run); }
}
window.addEventListener("hashchange", route);
document.addEventListener("keydown", function (e) {
  if (e.target && (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA")) { return; }
  if (e.key === "ArrowRight") { bookNext(); }
  if (e.key === "ArrowLeft") { bookPrev(); }
  if (e.key === "Escape") { location.href = LINK_SOLAR; }
});
route();
</script>
</body>
</html>
