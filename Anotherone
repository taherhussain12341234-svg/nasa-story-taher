#bookview{display:flex}
/* ===== Shared: page-turn, contents, toast, folio visuals ===== */
#leafwrap{position:fixed;inset:0;z-index:60;pointer-events:none;perspective:2200px;overflow:hidden}
#leaf{position:absolute;inset:0;transform-origin:0 50%;opacity:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;background:linear-gradient(90deg,#e4d3a0 0%,#fff2cf 9%,#fff8e1 60%,#f6e9c4 100%);box-shadow:inset -40px 0 70px rgba(120,86,24,.28)}
#leafwrap.go #leaf{animation:leaf .85s cubic-bezier(.55,.06,.25,1) both}
