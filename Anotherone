#leafwrap.go::after{animation:leafshade .85s ease both}
@keyframes leaf{0%{opacity:1;transform:rotateY(0)}14%{opacity:1;transform:rotateY(0)}100%{opacity:1;transform:rotateY(-104deg)}}
@keyframes leafshade{0%{opacity:0}30%{opacity:1}100%{opacity:0}}
