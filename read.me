          <div id="target-hud" class="absolute bottom-4 right-4 pointer-events-none font-telemetry text-[11px] text-secondary/80 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded border border-outline-variant/30 flex flex-col gap-0.5 shadow-xs text-right">
            <span class="text-primary font-bold">TARGET: Earth (Terra)</span>
            <span>SEMI-MAJOR: 1.00 AU</span>
            <span>VELOCITY: 29.78 km/s</span>
          </div>
        </div>

        <!-- Active Celestial Target Card -->
        <div class="w-full bg-white p-4 lg:p-6 rounded-xl shadow-xs border border-outline-variant/30 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
