        <div class="flex items-center gap-3 text-secondary text-right">
          <div class="flex flex-col">
            <span class="font-telemetry text-xs text-secondary font-medium">NEXT FOLIO</span>
            <span class="font-editorial text-base sm:text-lg font-bold text-on-surface">Ch 03: The Outer Moons & Ocean Worlds</span>
          </div>
          <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="w-full bg-surface-container-low border-t border-outline-variant/30">
