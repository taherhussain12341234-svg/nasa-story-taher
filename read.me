        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs font-telemetry" id="modal-metrics">
          <!-- Populated dynamically -->
        </div>

        <div>
          <h4 class="font-telemetry text-xs font-bold text-primary uppercase mb-2">Atmospheric Spectral Composition</h4>
          <div id="modal-atmosphere" class="flex flex-wrap gap-2 text-xs font-telemetry"></div>
        </div>
      </div>

      <div class="pt-4 border-t border-outline-variant/30 flex justify-end">
        <button id="btn-dismiss-modal" class="px-5 py-2 bg-primary hover:bg-primary-container text-white text-xs font-telemetry font-bold rounded">
          CLOSE DOSSIER
        </button>
      </div>
    </div>
  </div>

  <!-- Interactive JavaScript Engine -->
  <script>
    // Celestial Dataset
    const CELESTIAL_BODIES = [
      { id: 'sun', name: 'Sol (The Sun)', desc: 'Type G2V Yellow Dwarf · Gravitational anchor of Sol.', distanceAU: 0, radius: 11, color: 0xe65100, speed: 0, pillBg: 'bg-amber-500', semiMajor: '0.00 AU', vel: '0.00 km/s', period: 'Anchor', mass: '1.989 × 10³⁰ kg', temp: '5,500°C', atmo: ['Hydrogen 73.4%', 'Helium 25.0%'] },
      { id: 'mercury', name: 'Mercury', desc: '0.39 AU · The Swift Scorch · Heavily cratered silicate crust.', distanceAU: 0.39, distScale: 24, radius: 1.8, color: 0x64748b, speed: 0.045, pillBg: 'bg-slate-500', semiMajor: '0.39 AU', vel: '47.36 km/s', period: '87.97 d', mass: '3.301 × 10²³ kg', temp: '-180°C to 430°C', atmo: ['Oxygen 42%', 'Sodium 29%', 'Hydrogen 22%'] },
      { id: 'venus', name: 'Venus', desc: '0.72 AU · The Veiled Inferno · Supercritical CO₂ pressure (92 bar).', distanceAU: 0.72, distScale: 36, radius: 2.7, color: 0xd97706, speed: 0.028, pillBg: 'bg-amber-600', semiMajor: '0.72 AU', vel: '35.02 km/s', period: '224.7 d', mass: '4.867 × 10²⁴ kg', temp: '465°C', atmo: ['CO₂ 96.5%', 'Nitrogen 3.5%'] },
      { id: 'earth', name: 'Earth (Terra)', desc: '1.00 AU · Cradle of the Hydrosphere · Biosphere & ocean world.', distanceAU: 1.00, distScale: 52, radius: 3.2, color: 0x2563eb, speed: 0.020, hasMoon: true, pillBg: 'bg-blue-300', semiMajor: '1.00 AU', vel: '29.78 km/s', period: '365.25 d', mass: '5.972 × 10²⁴ kg', temp: '-88°C to 58°C', atmo: ['Nitrogen 78.1%', 'Oxygen 20.9%', 'Argon 0.9%'] },
      { id: 'mars', name: 'Mars', desc: '1.52 AU · The Rust World · Olympus Mons & polar dry-ice caps.', distanceAU: 1.52, distScale: 70, radius: 2.3, color: 0xd9532f, speed: 0.015, pillBg: 'bg-red-600', semiMajor: '1.52 AU', vel: '24.07 km/s', period: '686.98 d', mass: '6.417 × 10²³ kg', temp: '-140°C to 20°C', atmo: ['CO₂ 95.3%', 'Nitrogen 2.6%', 'Argon 1.9%'] },
      { id: 'jupiter', name: 'Jupiter', desc: '5.20 AU · The King of Storms · 95 satellites & Great Red Spot.', distanceAU: 5.20, distScale: 96, radius: 7.2, color: 0xb45309, speed: 0.009, pillBg: 'bg-amber-700', semiMajor: '5.20 AU', vel: '13.07 km/s', period: '11.86 yrs', mass: '1.898 × 10²⁷ kg', temp: '-110°C', atmo: ['Hydrogen 89.8%', 'Helium 10.2%'] },
      { id: 'saturn', name: 'Saturn', desc: '9.58 AU · The Jewel of the Ring · Vast ice ring system.', distanceAU: 9.58, distScale: 124, radius: 6.0, color: 0xd97706, speed: 0.0065, hasRings: true, pillBg: 'bg-amber-400', semiMajor: '9.58 AU', vel: '9.68 km/s', period: '29.46 yrs', mass: '5.683 × 10²⁶ kg', temp: '-140°C', atmo: ['Hydrogen 96.3%', 'Helium 3.25%'] },
      { id: 'uranus', name: 'Uranus', desc: '19.2 AU · The Tilted Ice Giant · 97.8° extreme axial tilt.', distanceAU: 19.2, distScale: 150, radius: 4.4, color: 0x0891b2, speed: 0.0045, pillBg: 'bg-cyan-500', semiMajor: '19.2 AU', vel: '6.80 km/s', period: '84.01 yrs', mass: '8.681 × 10²⁵ kg', temp: '-195°C', atmo: ['Hydrogen 82.5%', 'Helium 15.2%', 'Methane 2.3%'] },
      { id: 'neptune', name: 'Neptune', desc: '30.1 AU · The Azure Tempest · Supersonic winds reaching 2,100 km/h.', distanceAU: 30.1, distScale: 174, radius: 4.2, color: 0x1d4ed8, speed: 0.0035, pillBg: 'bg-blue-600', semiMajor: '30.1 AU', vel: '5.43 km/s', period: '164.8 yrs', mass: '1.024 × 10²⁶ kg', temp: '-201°C', atmo: ['Hydrogen 80.0%', 'Helium 19.0%', 'Methane 1.5%'] }
    ];

    let currentSelected = CELESTIAL_BODIES[3]; // Earth
    let simSpeed = 0.6;

    // Render Pills
    const pillsContainer = document.getElementById('pills-container');
    CELESTIAL_BODIES.forEach(body => {
      const btn = document.createElement('button');
      btn.className = `pill-btn px-3 py-1 rounded-full whitespace-nowrap transition-all flex items-center gap-1.5 cursor-pointer border ${
        body.id === currentSelected.id ? 'bg-primary text-white font-semibold border-primary shadow-xs' : 'bg-white hover:bg-surface-container text-on-surface border-outline-variant/40'
      }`;
      btn.innerHTML = `<span class="w-2 h-2 rounded-full ${body.pillBg}"></span><span>${body.name}</span>`;
      btn.onclick = () => selectBody(body);
      pillsContainer.appendChild(btn);
    });

    function selectBody(body) {
      currentSelected = body;
      // Update pills styles
      document.querySelectorAll('.pill-btn').forEach((b, idx) => {
        const isCurrent = CELESTIAL_BODIES[idx].id === body.id;
        b.className = `pill-btn px-3 py-1 rounded-full whitespace-nowrap transition-all flex items-center gap-1.5 cursor-pointer border ${
          isCurrent ? 'bg-primary text-white font-semibold border-primary shadow-xs' : 'bg-white hover:bg-surface-container text-on-surface border-outline-variant/40'
        }`;
      });

      // Update card
      document.getElementById('target-title').textContent = body.name;
      document.getElementById('target-desc').textContent = body.desc;
      const shortName = body.name.split(' ')[0];
      document.getElementById('target-cta-label').textContent = `Open ${shortName} Field Dossier`;
      document.getElementById('target-icon-box').style.backgroundColor = '#' + body.color.toString(16).padStart(6, '0');

      // Update HUD
      document.getElementById('target-hud').innerHTML = `
        <span class="text-primary font-bold">TARGET: ${body.name}</span>
        <span>SEMI-MAJOR: ${body.semiMajor}</span>
        <span>VELOCITY: ${body.vel}</span>
      `;
    }

    // Modal Handling
    const modal = document.getElementById('dossier-modal');
    document.getElementById('btn-open-dossier').onclick = () => {
      document.getElementById('modal-title').textContent = currentSelected.name;
      document.getElementById('modal-subtitle').textContent = currentSelected.desc;
      document.getElementById('modal-notes').textContent = `Precision Keplerian ephemeris coordinates decoded under J2000 epoch heliocentric coordinates. Standard gravitational parameter active.`;
      
      const metrics = [
        { label: 'SEMI-MAJOR AXIS', val: currentSelected.semiMajor },
        { label: 'ORBITAL VELOCITY', val: currentSelected.vel },
        { label: 'ORBITAL PERIOD', val: currentSelected.period },
        { label: 'TOTAL MASS', val: currentSelected.mass },
        { label: 'SURFACE TEMP', val: currentSelected.temp }
      ];

      document.getElementById('modal-metrics').innerHTML = metrics.map(m => `
        <div class="p-2.5 bg-surface-container-low rounded border border-outline-variant/20">
          <span class="text-slate-400 block text-[9px] uppercase">${m.label}</span>
          <span class="font-bold text-slate-800">${m.val}</span>
        </div>
      `).join('');

      document.getElementById('modal-atmosphere').innerHTML = currentSelected.atmo.map(a => `
        <span class="px-2 py-1 bg-surface-container rounded border border-outline-variant/30 text-slate-700">${a}</span>
      `).join('');

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    };

    const closeModal = () => {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
    };
    document.getElementById('btn-close-modal').onclick = closeModal;
    document.getElementById('btn-dismiss-modal').onclick = closeModal;

    // Time Accelerations
    document.querySelectorAll('.speed-btn').forEach(btn => {
      btn.onclick = () => {
        simSpeed = parseFloat(btn.dataset.speed);
        document.querySelectorAll('.speed-btn').forEach(b => {
          b.className = 'speed-btn px-2.5 py-1 rounded bg-surface-container text-on-surface-variant hover:bg-surface-container-high transition-colors';
        });
        btn.className = 'speed-btn px-2.5 py-1 rounded bg-primary text-white font-bold shadow-xs transition-colors';
      };
    });

    // Three.js Interactive Orrery Setup
    const container = document.getElementById('threejs-canvas');
    const width = container.clientWidth || window.innerWidth;
    const height = container.clientHeight || 560;

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xf8faff);

    const camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 2000);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // Lighting
    scene.add(new THREE.AmbientLight(0xe2e8f0, 1.4));
    const sunLight = new THREE.PointLight(0xff7a00, 3.5, 600);
    scene.add(sunLight);
    const hemiLight = new THREE.HemisphereLight(0xffffff, 0xcbd5e1, 1.0);
    hemiLight.position.set(0, 150, 0);
    scene.add(hemiLight);

    // Polar Grid floor
    const polarGrid = new THREE.PolarGridHelper(190, 8, 8, 64, 0xccd6e0, 0xe2e8f0);
    polarGrid.position.y = -0.5;
    scene.add(polarGrid);

    // Sun
    const sunGeom = new THREE.SphereGeometry(11, 32, 32);
    const sunMat = new THREE.MeshStandardMaterial({ color: 0xe65100, roughness: 0.3 });
    const sunMesh = new THREE.Mesh(sunGeom, sunMat);
    sunMesh.userData = { id: 'sun' };
    scene.add(sunMesh);

    // Corona
    const coronaGeom = new THREE.SphereGeometry(13.8, 32, 32);
    const coronaMat = new THREE.MeshBasicMaterial({ color: 0xffa726, transparent: true, opacity: 0.35, side: THREE.BackSide });
    sunMesh.add(new THREE.Mesh(coronaGeom, coronaMat));

    // Planets
    const planetBodies = [];
    const clickableObjects = [sunMesh];

    CELESTIAL_BODIES.filter(b => b.id !== 'sun').forEach((data, idx) => {
      // Orbit Ring
      const orbitPoints = [];
      for (let i = 0; i <= 100; i++) {
        const theta = (i / 100) * Math.PI * 2;
        orbitPoints.push(new THREE.Vector3(Math.cos(theta) * data.distScale, 0, Math.sin(theta) * data.distScale));
      }
      const orbitLine = new THREE.Line(
        new THREE.BufferGeometry().setFromPoints(orbitPoints),
        new THREE.LineBasicMaterial({ color: 0x94a3b8, transparent: true, opacity: 0.5 })
      );
      scene.add(orbitLine);

      // Planet Mesh
      const mesh = new THREE.Mesh(
        new THREE.SphereGeometry(data.radius, 24, 24),
        new THREE.MeshStandardMaterial({ color: data.color, roughness: 0.45 })
      );
      mesh.userData = { id: data.id };
      scene.add(mesh);
      clickableObjects.push(mesh);

      // Rings for Saturn
      if (data.hasRings) {
        const ring = new THREE.Mesh(
          new THREE.RingGeometry(data.radius * 1.35, data.radius * 2.35, 36),
          new THREE.MeshBasicMaterial({ color: 0xd4a373, side: THREE.DoubleSide, transparent: true, opacity: 0.8 })
        );
        ring.rotation.x = Math.PI / 2.3;
        mesh.add(ring);
      }

      // Moon for Earth
      let moonMesh;
      if (data.hasMoon) {
        moonMesh = new THREE.Mesh(
          new THREE.SphereGeometry(0.85, 16, 16),
          new THREE.MeshStandardMaterial({ color: 0x94a3b8 })
        );
        mesh.add(moonMesh);
      }

      const angle = idx * 0.9 + 0.4;
      mesh.position.set(Math.cos(angle) * data.distScale, 0, Math.sin(angle) * data.distScale);

      planetBodies.push({ data, mesh, angle, moonMesh });
    });

    // Camera Spherical Controls
    let radius = 260, theta = Math.PI / 3.8, phi = Math.PI / 4.5;
    let isDragging = false, prevMouse = { x: 0, y: 0 };

    function updateCamera() {
      camera.position.x = radius * Math.sin(theta) * Math.sin(phi);
      camera.position.y = radius * Math.cos(theta);
      camera.position.z = radius * Math.sin(theta) * Math.cos(phi);
      camera.lookAt(0, 0, 0);
    }
    updateCamera();

    container.addEventListener('mousedown', (e) => {
      isDragging = true;
      prevMouse = { x: e.clientX, y: e.clientY };
      container.style.cursor = 'grabbing';
    });
    window.addEventListener('mouseup', () => {
      isDragging = false;
      container.style.cursor = 'grab';
    });
    container.addEventListener('mousemove', (e) => {
      if (isDragging) {
        const dx = e.clientX - prevMouse.x;
        const dy = e.clientY - prevMouse.y;
        phi -= dx * 0.007;
        theta = Math.max(0.08, Math.min(Math.PI / 2.05, theta - dy * 0.007));
        updateCamera();
        prevMouse = { x: e.clientX, y: e.clientY };
      }
    });

    container.addEventListener('wheel', (e) => {
      e.preventDefault();
      radius = Math.max(70, Math.min(380, radius + e.deltaY * 0.22));
      updateCamera();
    }, { passive: false });

    // Raycast click
    const raycaster = new THREE.Raycaster();
    const mouse = new THREE.Vector2();

    container.addEventListener('click', (e) => {
      const rect = container.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / container.clientWidth) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / container.clientHeight) * 2 + 1;
      raycaster.setFromCamera(mouse, camera);
      const hits = raycaster.intersectObjects(clickableObjects);
      if (hits.length > 0) {
        const found = CELESTIAL_BODIES.find(b => b.id === hits[0].object.userData.id);
        if (found) selectBody(found);
      }
    });

    // View Presets
    document.getElementById('btn-topdown').onclick = () => {
      radius = 270; theta = 0.08; phi = Math.PI / 4.5;
      updateCamera();
    };
    document.getElementById('btn-reset').onclick = () => {
      radius = 260; theta = Math.PI / 3.8; phi = Math.PI / 4.5;
      updateCamera();
    };

    // Animation Loop
    let moonAngle = 0;
    function animate() {
      requestAnimationFrame(animate);
      sunMesh.rotation.y += 0.003;

      planetBodies.forEach(p => {
        p.angle += p.data.speed * simSpeed * 0.05;
        p.mesh.position.x = Math.cos(p.angle) * p.data.distScale;
        p.mesh.position.z = Math.sin(p.angle) * p.data.distScale;
        p.mesh.rotation.y += 0.02;

        if (p.moonMesh && simSpeed > 0) {
          moonAngle += 0.04;
          p.moonMesh.position.set(Math.cos(moonAngle) * 5.5, 0.4, Math.sin(moonAngle) * 5.5);
        }
      });

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      const w = container.clientWidth;
      const h = container.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    });

    // Live MET Clock
    let metSec = 142 * 3600 + 8 * 60 + 19;
    setInterval(() => {
      metSec++;
      const h = Math.floor(metSec / 3600);
      const m = Math.floor((metSec % 3600) / 60);
      const s = metSec % 60;
      document.getElementById('met-clock').textContent = `MET +${h}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')} UTC`;
    }, 1000);
  </script>
</body>
</html>
