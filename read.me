  <!-- Modal: Planetary Dossier -->
  <div id="dossier-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/50 backdrop-blur-xs">
    <div class="bg-white rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto border border-outline-variant/40 shadow-2xl p-6">
      <div class="flex justify-between items-center pb-3 border-b border-outline-variant/30">
        <div>
          <span class="font-telemetry text-xs text-primary font-bold uppercase">NASA PDS FIELD DOSSIER // DE440</span>
          <h2 id="modal-title" class="font-editorial text-2xl font-bold text-slate-900">Earth (Terra)</h2>
        </div>
        <button id="btn-close-modal" class="text-xl font-bold text-slate-500 hover:text-slate-800 p-1">✕</button>
      </div>

      <div class="py-4 space-y-4">
        <div class="p-4 bg-surface-container-low rounded border border-outline-variant/30">
          <div id="modal-subtitle" class="font-editorial italic text-base text-slate-800 mb-1"></div>
