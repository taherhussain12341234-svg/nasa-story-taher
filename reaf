<script>
  // Simple interaction for Field Journal Note submission
  const logBtn = document.getElementById('btn-save-log');
  const logInput = document.getElementById('journal-note-input');

  if (logBtn && logInput) {
    logBtn.addEventListener('click', () => {
      const val = logInput.value.trim();
      if (!val) {
        logInput.focus();
        return;
      }
      const prevText = logBtn.innerHTML;
      logBtn.innerHTML = '<span class="material-symbols-outlined text-[16px]">check</span><span>Appended</span>';
      logBtn.classList.remove('bg-primary');
      logBtn.classList.add('bg-tertiary', 'text-on-tertiary');
      
      setTimeout(() => {
        logInput.value = '';
        logBtn.innerHTML = prevText;
        logBtn.classList.remove('bg-tertiary', 'text-on-tertiary');
        logBtn.classList.add('bg-primary', 'text-on-primary');
      }, 1600);
    });

    logInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        logBtn.click();
      }
    });
  }
