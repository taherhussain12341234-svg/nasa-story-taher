<div class="p-space-md rounded-xl bg-surface-container-low shadow-sm flex flex-col gap-3">
<div class="flex items-center justify-between">
<span class="font-label-sm text-label-sm text-secondary uppercase font-bold tracking-wider">FIELD LOGBOOK // OPERATOR MEMO</span>
<span class="material-symbols-outlined text-outline text-[18px]">edit_note</span>
</div>
<blockquote class="font-headline-sm text-[16px] leading-[24px] italic text-text-charcoal border-l-2 border-secondary pl-3">
        “There is no whisper of wind upon this world. Every impact crater from the Late Heavy Bombardment remains precisely as it was carved four billion years ago, pristine, quiet, and blinding under the solar gaze.”
      </blockquote>
<!-- Interactive Annotations Input -->
<div class="mt-2 flex flex-col gap-2">
<label class="font-label-sm text-label-sm text-outline uppercase font-medium" for="memo-input">Add Folio Margin Note</label>
<div class="flex gap-2">
<input class="flex-1 px-3 py-2 rounded bg-surface-container-lowest text-text-charcoal font-label-sm text-label-sm outline-none placeholder:text-outline/70 shadow-sm focus:ring-1 focus:ring-primary" id="memo-input" placeholder="Log observational annotation..." type="text"/>
<button class="px-4 py-2 bg-primary hover:bg-primary-container text-on-primary rounded font-label-sm text-label-sm font-semibold transition-colors shadow-sm shrink-0 flex items-center gap-1" id="memo-btn">
<span class="material-symbols-outlined text-[16px]">save</span>
<span>Log</span>
</button>
</div>
<p class="font-label-sm text-label-sm text-secondary font-medium hidden" id="memo-status">✓ Note synchronized with local dossier session.</p>
</div>
</div>
<!-- Data Actions & Quick Exports -->
<div class="flex flex-col gap-2.5">
<span class="font-label-sm text-label-sm uppercase tracking-wider text-outline font-medium">EXPORT SCIENTIFIC DATASET</span>
<div class="grid grid-cols-2 gap-2">
<button class="h-11 px-3 rounded-lg bg-surface-container-lowest shadow-sm hover:bg-surface-slate-subtle transition-colors flex items-center justify-center gap-1.5 text-text-charcoal font-label-sm text-label-sm font-medium">
<span class="material-symbols-outlined text-secondary text-[18px]">download</span>
<span class="truncate">FITS Raster (16-bit)</span>
</button>
<button class="h-11 px-3 rounded-lg bg-surface-container-lowest shadow-sm hover:bg-surface-slate-subtle transition-colors flex items-center justify-center gap-1.5 text-text-charcoal font-label-sm text-label-sm font-medium">
<span class="material-symbols-outlined text-secondary text-[18px]">table_chart</span>
<span class="truncate">Thermal CSV (610K)</span>
</button>
</div>
</div>
</div>
<!-- Archival Footer & Node Synchronization -->
<div class="px-gutter-mobile pb-space-xl pt-space-xs flex flex-col items-center text-center gap-2">
<div class="w-8 h-1 rounded-full bg-surface-container-highest"></div>
<span class="font-label-sm text-label-sm text-outline tracking-wider uppercase">
      NASA PDS SYNCHRONIZED // GEO-NODE MD02
    </span>
<p class="font-label-sm text-[9px] leading-3 text-outline">
      CALIBRATION ALGORITHM: MDIS-CDR-REV4 // ARCHIVAL RECORD ID: 2025-HG-88
    </p>
</div>
</div>
<script>
  // Simple viewport micro-interactions
  const planetImg = document.getElementById('planet-viewport-img');
  const rotateBtn = document.getElementById('toggle-rotate');
  const modeBtn = document.getElementById('toggle-mode');
  const thermalBtn = document.getElementById('toggle-thermal');
  const memoBtn = document.getElementById('memo-btn');
  const memoInput = document.getElementById('memo-input');
  const memoStatus = document.getElementById('memo-status');

  let currentRotation = 0;
  let isThermal = false;
  let isTerminator = false;

  if (rotateBtn && planetImg) {
    rotateBtn.addEventListener('click', () => {
      currentRotation = (currentRotation + 45) % 360;
      planetImg.style.transform = `rotate(${currentRotation}deg) scale(${isThermal ? 1.05 : 1})`;
    });
  }

  if (thermalBtn && planetImg) {
    thermalBtn.addEventListener('click', () => {
      isThermal = !isThermal;
      if (isThermal) {
        planetImg.style.filter = 'hue-rotate(180deg) saturate(2.5) contrast(1.2)';
        thermalBtn.classList.add('bg-focal-crimson', 'text-on-error');
      } else {
        planetImg.style.filter = isTerminator ? 'contrast(1.6) brightness(0.85)' : 'none';
        thermalBtn.classList.remove('bg-focal-crimson', 'text-on-error');
      }
    });
  }

  if (modeBtn && planetImg) {
    modeBtn.addEventListener('click', () => {
      isTerminator = !isTerminator;
      if (isTerminator) {
        planetImg.style.filter = 'contrast(1.6) brightness(0.85)';
        modeBtn.classList.add('bg-secondary', 'text-on-secondary');
      } else {
        planetImg.style.filter = isThermal ? 'hue-rotate(180deg) saturate(2.5) contrast(1.2)' : 'none';
        modeBtn.classList.remove('bg-secondary', 'text-on-secondary');
      }
    });
  }

  if (memoBtn && memoInput && memoStatus) {
    memoBtn.addEventListener('click', () => {
      if (memoInput.value.trim().length > 0) {
        memoStatus.classList.remove('hidden');
        memoInput.value = '';
        setTimeout(() => {
          memoStatus.classList.add('hidden');
        }, 3500);
      }
    });
  }
</script></main></body></html>
